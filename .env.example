# Copy this file to .env and replace all three values before starting Docker Compose.
# The values below are intentionally empty; real credentials must never be committed.
POSTGRES_PASSWORD=
KEYCLOAK_ADMIN_PASSWORD=
GRAFANA_ADMIN_PASSWORD=

# Optional local-model overrides. qwen3.5:4b is the reviewed 6 GB GPU baseline.
# AI_CHAT_MODEL=qwen3.5:4b
# OLLAMA_MAX_LOADED_MODELS=2

# Experimental complementary retrieval; enable only after IA v4 acceptance.
# LORE_HYBRID_ENABLED=false
# LORE_LEXICAL_MINIMUM_COVERAGE=1.0
# QA_SELECTION_PROMPT_VERSION=v1

# Experimental context and omission checks, pending IA v5 acceptance.
# LORE_CONTEXTUAL_PASSAGES_ENABLED=false
# QA_COMPLETE_SELECTION_ENABLED=false
